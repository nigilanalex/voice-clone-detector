{
    "id": "/",
    "name": "VoiceGuard AI",
    "short_name": "VoiceGuard",
    "description": "Screen recordings and live microphone audio for signs of AI-generated or cloned speech.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "any",
    "lang": "en",
    "dir": "ltr",
    "background_color": "#07111f",
    "theme_color": "#07111f",
    "categories": ["security", "utilities"],
    "prefer_related_applications": false,
    "launch_handler": { "client_mode": "navigate-existing" },
    "icons": [
        {
            "src": "/static/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "/static/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Analyze a recording",
            "short_name": "Upload",
            "url": "/#upload-card",
            "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Live microphone",
            "short_name": "Live check",
            "url": "/#live-card",
            "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        }
    ]
}
