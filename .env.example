# Copy this file to .env and load it before starting VoiceGuard.
# Never commit the real .env file.

# Metadata-only SQLite audit store (no audio or filename is stored).
VOICEGUARD_AUDIT_DB=data/voiceguard.db
VOICEGUARD_AUDIT_RETENTION_DAYS=30

# Optional HTTPS webhook. Compatible with an automation endpoint that accepts JSON.
VOICEGUARD_ALERT_WEBHOOK_URL=

# Optional SMTP email alerts for HIGH and CRITICAL events.
VOICEGUARD_SMTP_HOST=
VOICEGUARD_SMTP_PORT=587
VOICEGUARD_SMTP_USERNAME=
VOICEGUARD_SMTP_PASSWORD=
VOICEGUARD_ALERT_FROM=
VOICEGUARD_ALERT_TO=

# Existing policy settings.
VOICEGUARD_POLICY_MEDIUM=25
VOICEGUARD_POLICY_HIGH=45
VOICEGUARD_POLICY_CRITICAL=70
